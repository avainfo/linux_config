#!/bin/sh

# macOS: start a regular login shell
if [ "$(uname -s)" = "Darwin" ]; then
    exec zsh -l
fi

# Prevent inherited tmux state
unset TMUX TMUX_PANE

# Fall back to Zsh if tmux is unavailable
if ! command -v tmux >/dev/null 2>&1; then
    exec zsh -l
fi

# Find the first available session name
i=0

while tmux has-session -t "=tmux${i}" 2>/dev/null; do
    i=$((i + 1))
done

# Keep the terminal usable even if tmux fails
tmux new-session -s "tmux${i}" || exec zsh -l
